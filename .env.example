# Public hostnames. Create DNS A records pointing both names to the VPS.
AIRFLOW_DOMAIN=airflow.example.com
DASHBOARD_DOMAIN=dashboard.example.com

# Private Airflow metadata database (used only inside Docker Compose).
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with:
# docker run --rm apache/airflow:2.9.2-python3.12 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=replace-with-generated-fernet-key
# Generate with: openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-generated-webserver-secret

# Airflow demo/admin account. Use a unique password.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-long-random-password
AIRFLOW_ADMIN_FIRSTNAME=Project
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=you@example.com

# Read-only account you can share with recruiters.
AIRFLOW_DEMO_USERNAME=demo
AIRFLOW_DEMO_PASSWORD=replace-with-a-different-random-password
AIRFLOW_DEMO_EMAIL=demo@example.com

# Supabase API credentials used by ingestion and analytics tasks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# PostgreSQL URL used by the Streamlit dashboard. Prefer the Supabase pooler.
# URL-encode special characters in the password and require SSL.
DATABASE_URL=postgresql+psycopg2://user:password@host:6543/postgres?sslmode=require

# Incoming email ingestion.
EXPECTED_SENDER=sender@example.com
EMAIL_USER=your-ingestion-mailbox@example.com
EMAIL_PASS=replace-with-an-app-password
SUBJECT_ALLOW=Supply Chain Data,Weekly Supply Chain Update
POLL_SECONDS=300
ONCE=true

# Outgoing alert email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-alert-mailbox@example.com
SMTP_PASS=replace-with-an-app-password
ALERT_FROM=your-alert-mailbox@example.com
ALERT_TO=you@example.com

# Alert behavior.
DUPLICATE_WINDOW_MINUTES=60
ALERT_ON_STOCKOUT=true
